<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Player</title>
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <div id="main-container">
      <div id="music-list-container">
        <ul id="music-list"></ul>
      </div>
      <div id="music-info-container">
        <div id="music-name"></div>
        <div id="music-controler-container">
          <div id="slider">
            <div id="ball"></div>
          </div>
          <div id="btn-container">
            <button class="ctrl-btn" id="prev-btn">Previous</button>
            <button class="ctrl-btn" id="play-btn">Play</button>
            <button class="ctrl-btn" id="next-btn">Next</button>
          </div>
        </div>
      </div>
    </div>

    <script src="script.js"></script>
  </body>
</html>
